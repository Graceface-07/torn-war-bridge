function displaySummaryBar() {
  let html = '';
  if(!loadedUser || !loadedUser.profile) return;
  let name = loadedUser.profile.name || '-';
  let lvl = loadedUser.profile.level || '-';
  let facName = loadedFaction?.basic?.name || '-';
  let stats = loadedUser.battlestats || {};
  let totalStats =
    [stats.strength,stats.speed,stats.defense,stats.dexterity]
      .map(x=>typeof x==='number'?x:parseFloat(x)||0).reduce((a,b)=>a+b,0);
  html += `<span class="field">User: <b>${name}</b> (Lv ${lvl})</span>`;
  html += `<span class="field">Faction: <b>${facName}</b></span>`;
  html += `<span class="field">Total Battle Stats: <b>${totalStats.toLocaleString()}</b></span>`;
  document.getElementById('summarybar').innerHTML = html;
  document.getElementById('summarybar').style.display = 'block';
}


<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Torn Command Center</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
:root {
  --bg:#0b0f14; --panel:#121822; --panel2:#151c27; --border:#1f2a3a;
  --text:#e6e9ef; --muted:#9aa7be; --amber:#f5b641; --cyan:#52d6ff;
  --teal:#3ed1a5; --violet:#b78bff; --danger:#ff5f6d; --success:#6ae38f;
}
* { box-sizing:border-box; }
body { margin:0; background:var(--bg); color:var(--text); font-family:'Inter','Roboto',sans-serif; }
h1,h2,h3,h4 { margin:0; }
button { cursor:pointer; }
.container { display:flex; flex-direction:column; min-height:100vh; }
.topbar { display:flex; align-items:center; justify-content:space-between; padding:12px 16px; background:var(--panel); border-bottom:1px solid var(--border); gap:8px; flex-wrap:wrap; }
.status-ribbon { padding:6px 10px; border:1px solid var(--border); border-radius:8px; font-size:12px; color:var(--amber); }
.main { display:flex; flex:1; overflow:hidden; }
.center { flex:1; padding:12px; overflow:auto; }
.tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:10px; padding:12px; background:var(--panel2); border:1px solid var(--border); border-radius:10px; }
.tile { padding:12px; background:var(--panel); border:1px solid var(--border); border-radius:10px; transition:0.15s; }
.tile:hover { border-color:var(--amber); }
.tile.stat { border-left:4px solid var(--amber); }
.tile.war { border-left:4px solid var(--cyan); }
.tile.income { border-left:4px solid var(--teal); }
.tile.faction { border-left:4px solid var(--violet); }
.tile.custom { border-left:4px solid var(--muted); }
.label-sm { font-size:12px; color:var(--muted); }
.helper { position:fixed; right:12px; bottom:12px; width:280px; background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:12px; box-shadow:0 8px 20px rgba(0,0,0,0.35); z-index:5; }
.helper-section { margin-bottom:8px; font-size:12px; color:var(--muted); }
.helper-section strong { color:var(--text); }
.drawer { position:fixed; left:-340px; top:0; width:320px; height:100%; background:var(--panel); border-right:1px solid var(--border); padding:12px; transition:0.2s; overflow:auto; z-index:4; }
.drawer.open { left:0; }
.drawer-toggle { position:fixed; left:0; top:50%; transform:translate(-50%,-50%); background:var(--amber); color:#000; padding:8px; border-radius:50%; font-weight:700; border:2px solid #000; z-index:5; }
.section-title { font-size:13px; color:var(--muted); margin:10px 0 6px; }
.checklist-item { padding:8px; border:1px solid var(--border); border-radius:8px; margin-bottom:6px; background:var(--panel2); display:grid; grid-template-columns:auto 1fr; gap:8px; align-items:flex-start; }
.badge { padding:2px 6px; border-radius:6px; font-size:11px; color:#000; font-weight:700; }
.badge.week { background:var(--amber); }
.badge.today { background:var(--cyan); color:#000; }
.badge.month { background:var(--muted); color:#000; }
.controls { display:flex; gap:6px; flex-wrap:wrap; }
.button { background:var(--amber); color:#000; border:none; padding:8px 12px; border-radius:8px; font-weight:700; }
.button.secondary { background:var(--panel2); color:var(--text); border:1px solid var(--border); }
.modal-backdrop { position:fixed; inset:0; background:rgba(0,0,0,0.55); display:none; align-items:center; justify-content:center; z-index:6; }
.modal { background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:16px; width:90%; max-width:720px; max-height:85vh; overflow:auto; }
.modal-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; }
.modal-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:10px; }
.kpi { padding:10px; border:1px solid var(--border); border-radius:10px; background:var(--panel2); }
.small { font-size:12px; color:var(--muted); }
.input-row { display:flex; gap:8px; flex-wrap:wrap; margin:8px 0; }
input, select, textarea { background:var(--panel2); border:1px solid var(--border); color:var(--text); padding:8px; border-radius:8px; font-size:14px; }
textarea { width:100%; min-height:50px; }
.progress { font-size:12px; color:var(--muted); }
.mark-all { font-size:12px; color:var(--amber); cursor:pointer; }
</style>
</head>
<body>
<div class="container">
  <div class="topbar">
    <div>Command Center v2</div>
    <div class="controls">
      <button class="button secondary" id="btnAddTask">Add Task</button>
      <select id="filterGoal">
        <option value="">All goals</option>
        <option value="stat">Stat Growth</option>
        <option value="war">War Readiness</option>
        <option value="income">Income</option>
        <option value="faction">Faction Support</option>
        <option value="custom">Custom</option>
      </select>
      <select id="filterBucket">
        <option value="">All buckets</option>
        <option value="today">Today</option>
        <option value="week1">Week 1</option>
        <option value="week2">Week 2</option>
        <option value="week3">Week 3</option>
        <option value="week4">Week 4</option>
        <option value="month">Month</option>
      </select>
      <div class="status-ribbon" id="statusRibbon">Live</div>
    </div>
  </div>

  <div class="main">
    <div class="center">
      <div class="tiles" id="tiles"></div>
      <div id="hudArea" class="label-sm" style="padding:12px;">HUD cards go here (wiring later).</div>
    </div>
  </div>
</div>

<div class="drawer" id="drawer">
  <div class="section-title">This Month (Week 1–4)</div>
  <div id="checklist"></div>
</div>
<div class="drawer-toggle" id="drawerToggle">›</div>

<div class="helper" id="helper">
  <h4>Helper</h4>
  <div class="helper-section"><strong>Quick:</strong> <span id="hQuick">—</span></div>
  <div class="helper-section"><strong>Alternatives:</strong> <span id="hAlt">—</span></div>
  <div class="helper-section"><strong>Caution:</strong> <span id="hCaution">—</span></div>
  <div class="helper-section"><strong>Next step:</strong> <span id="hNext">—</span></div>
</div>

<div class="modal-backdrop" id="backdrop">
  <div class="modal">
    <div class="modal-header">
      <div id="modalTitle">Category</div>
      <button class="button secondary" id="btnCloseModal">Close</button>
    </div>
    <div class="modal-grid" id="modalKpis"></div>
    <div class="section-title">Tasks (Week 1–4)</div>
    <div id="modalTasks"></div>
  </div>
</div>

<div class="modal-backdrop" id="taskModal">
  <div class="modal" style="max-width:520px;">
    <div class="modal-header">
      <div id="taskModalTitle">Add Task</div>
      <button class="button secondary" id="btnCloseTaskModal">Close</button>
    </div>
    <div>
      <div class="input-row">
        <input id="taskTitle" placeholder="Task title" style="flex:1;">
      </div>
      <div class="input-row">
        <select id="taskGoal">
          <option value="stat">Stat Growth</option>
          <option value="war">War Readiness</option>
          <option value="income">Income</option>
          <option value="faction">Faction Support</option>
          <option value="custom">Custom</option>
        </select>
        <select id="taskBucket">
          <option value="today">Today</option>
          <option value="week1">Week 1</option>
          <option value="week2">Week 2</option>
          <option value="week3">Week 3</option>
          <option value="week4">Week 4</option>
          <option value="month">Month</option>
        </select>
      </div>
      <div class="input-row">
        <textarea id="taskNote" placeholder="Note / rationale (optional)"></textarea>
      </div>
      <div class="input-row">
        <input id="taskLink" placeholder="Link (optional)" style="flex:1;">
      </div>
      <div class="input-row" style="justify-content:flex-end; gap:8px;">
        <button class="button secondary" id="btnSnoozeWeek">Snooze +1 week</button>
        <button class="button" id="btnSaveTask">Save</button>
      </div>
    </div>
  </div>
</div>

<script>
const categories = {
  stat:    { key:'stat',    name:'Stat Growth',     color:'var(--amber)' },
  war:     { key:'war',     name:'War Readiness',   color:'var(--cyan)' },
  income:  { key:'income',  name:'Income',          color:'var(--teal)' },
  faction: { key:'faction', name:'Faction Support', color:'var(--violet)' },
  custom:  { key:'custom',  name:'Custom',          color:'var(--muted)' }
};

const defaults = { tasks: [], currentCategory: 'stat', kpis: {} };
let state = { tasks: [], currentCategory: 'stat', kpis: {} };
let editingId = null;

function save() { localStorage.setItem('twb_state', JSON.stringify(state)); }
function load() {
  const raw = localStorage.getItem('twb_state');
  if (raw) {
    try { state = Object.assign({}, defaults, JSON.parse(raw)); }
    catch (e) { state = Object.assign({}, defaults); }
  }
}
function id() { return 't' + Math.random().toString(36).slice(2,9); }
function labelBucket(b) {
  if (b === 'today') return 'Today';
  if (b === 'month') return 'Month';
  return b.replace('week','Week ');
}
function toggleDrawer(){ document.getElementById('drawer').classList.toggle('open'); }

function setStatus(text, colorVar) {
  const el = document.getElementById('statusRibbon');
  el.textContent = text;
  el.style.color = colorVar ? 'var(' + colorVar + ')' : 'var(--amber)';
}

function helperSuggest(cat) {
  const q = document.getElementById('hQuick');
  const a = document.getElementById('hAlt');
  const c = document.getElementById('hCaution');
  const n = document.getElementById('hNext');
  if (cat.name === 'Stat Growth') {
    q.textContent = 'Run 2 more stat sessions; focus on best multiplier.';
    a.textContent = 'If blocked, short warm-up or plan Week 2.';
    c.textContent = 'Avoid burning energy if hospital countdown <15m.';
    n.textContent = 'Re-check FF band; rerun scout in 30–45s.';
  } else {
    q.textContent = 'Prioritize this category now.';
    a.textContent = 'If blocked, shift to Stat Growth tasks.';
    c.textContent = 'Watch timers/limits before committing.';
    n.textContent = 'Set 1–2 tasks in Week 1, then proceed.';
  }
}

function renderTiles() {
  const el = document.getElementById('tiles');
  el.innerHTML = '';
  Object.values(categories).forEach(function(cat) {
    const div = document.createElement('div');
    div.className = 'tile ' + cat.key;
    div.innerHTML = '<div>' + cat.name + '</div><div class="label-sm">' +
      (cat.key === 'stat' ? 'Default focus' : 'Click to open') +
      '</div>';
    div.onclick = function() { openCategory(cat.key); };
    el.appendChild(div);
  });
}

function openCategory(catKey) {
  state.currentCategory = catKey || 'stat';
  const c = categories[state.currentCategory];
  document.getElementById('modalTitle').textContent = c.name;
  renderModalKpis(c);
  renderModalTasks(c);
  document.getElementById('backdrop').style.display = 'flex';
  helperSuggest(c);
}
function closeCategory(){ document.getElementById('backdrop').style.display = 'none'; }

function renderModalKpis(cat) {
  const el = document.getElementById('modalKpis');
  el.innerHTML = '';
  const data = state.kpis[cat.key] || {};
  const kpis = [];
  if (cat.key === 'stat') {
    const done = data.sessionsDone != null ? data.sessionsDone : 0;
    const plan = data.sessionsPlanned != null ? data.sessionsPlanned : Math.max(done, 5);
    kpis.push({label:'Sessions done / planned', value: done + ' / ' + plan, sub:'Today'});
    kpis.push({label:'Time spent', value: data.timeSpent || '—', sub:'Today'});
    kpis.push({label:'Est. gain', value: data.estGain || '—', sub:'This week'});
    kpis.push({label:'FF band', value: data.ffBand || '—', sub:'Alignment'});
  } else {
    kpis.push({label:'Progress', value: data.progress || '—', sub: data.sub || 'Coming soon'});
  }
  kpis.forEach(function(k) {
    const d = document.createElement('div');
    d.className = 'kpi';
    d.innerHTML = '<div class="small">' + k.label + '</div><div style="font-size:16px;font-weight:700;">' + k.value + '</div><div class="small">' + (k.sub || '') + '</div>';
    el.appendChild(d);
  });
}

function renderModalTasks() {
  const el = document.getElementById('modalTasks');
  el.innerHTML = '';
  state.tasks.filter(function(t){ return t.goalId === state.currentCategory; }).forEach(function(t){
    el.appendChild(renderTaskItem(t, true));
  });
}

function renderChecklist(goalId) {
  const wrap = document.getElementById('checklist');
  wrap.innerHTML = '';
  const buckets = ['today','week1','week2','week3','week4','month'];
  const fGoal = document.getElementById('filterGoal').value;
  const fBucket = document.getElementById('filterBucket').value;

  const progress = {};
  state.tasks.forEach(function(t){
    if (fGoal && t.goalId !== fGoal) return;
    if (fBucket && t.bucket !== fBucket) return;
    const key = t.goalId + '-' + t.bucket;
    if (!progress[key]) progress[key] = { total:0, done:0 };
    progress[key].total += 1;
    if (t.status === 'done') progress[key].done += 1;
  });

  buckets.forEach(function(b){
    const section = document.createElement('div');
    section.innerHTML = '<div class="section-title">' + labelBucket(b) + '</div>';
    state.tasks
      .filter(function(t){ return (!goalId || t.goalId===goalId); })
      .filter(function(t){ return fGoal ? t.goalId===fGoal : true; })
      .filter(function(t){ return fBucket ? t.bucket===fBucket : true; })
      .filter(function(t){ return t.bucket===b; })
      .forEach(function(t){ section.appendChild(renderTaskItem(t,false)); });
    Object.keys(progress).forEach(function(key){
      const parts = key.split('-'); const g = parts[0]; const buck = parts[1];
      if (buck === b) {
        const val = progress[key];
        const prog = document.createElement('div');
        prog.className = 'progress';
        prog.textContent = (categories[g] ? categories[g].name : g) + ': ' + val.done + '/' + val.total + ' done';
        section.appendChild(prog);
      }
    });
    wrap.appendChild(section);
  });
}

function renderTaskItem(t, compact) {
  const div = document.createElement('div');
  div.className = 'checklist-item';
  div.innerHTML =
    '<input type="checkbox" ' + (t.status==='done' ? 'checked' : '') + ' data-id="' + t.id + '">' +
    '<div>' +
      '<div style="display:flex; justify-content:space-between; gap:8px;">' +
        '<div>' + t.title + '</div>' +
        '<span class="badge ' + (t.bucket==='today'?'today':t.bucket==='month'?'month':'week') + '">' + labelBucket(t.bucket) + '</span>' +
      '</div>' +
      (t.note ? '<div class="small">' + t.note + '</div>' : '') +
      (t.link ? '<div class="small"><a href="' + t.link + '" target="_blank" style="color:var(--cyan);">Link</a></div>' : '') +
      '<div class="small">Status: ' + t.status + '</div>' +
      '<div class="small mark-all" data-mark-goal="' + t.goalId + '">Mark all ' + (categories[t.goalId] ? categories[t.goalId].name : '') + ' done</div>' +
    '</div>';
  div.querySelector('input').onchange = function(){ toggleTask(t.id); };
  div.querySelector('.mark-all').onclick = function(){ markAllDone(t.goalId); };
  if (!compact) {
    const ctl = document.createElement('div');
    ctl.className = 'controls';
    const btnEdit = document.createElement('button'); btnEdit.className='button secondary'; btnEdit.textContent='Edit'; btnEdit.onclick=function(){ editTask(t.id); };
    const btnSnooze = document.createElement('button'); btnSnooze.className='button secondary'; btnSnooze.textContent='Snooze +1w'; btnSnooze.onclick=function(){ snoozeTask(t.id); };
    const btnDel = document.createElement('button'); btnDel.className='button secondary'; btnDel.style.color='var(--danger)'; btnDel.textContent='Delete'; btnDel.onclick=function(){ deleteTask(t.id); };
    ctl.appendChild(btnEdit); ctl.appendChild(btnSnooze); ctl.appendChild(btnDel);
    div.appendChild(ctl);
  }
  return div;
}

function toggleTask(id) {
  state.tasks = state.tasks.map(function(t){ return t.id===id ? Object.assign({}, t, { status: t.status==='done'?'todo':'done', updatedAt: Date.now() }) : t; });
  save(); renderAll();
}
function markAllDone(goalId) {
  state.tasks = state.tasks.map(function(t){ return t.goalId===goalId ? Object.assign({}, t, { status:'done', updatedAt: Date.now() }) : t; });
  save(); renderAll();
}
function snoozeTask(id) {
  state.tasks = state.tasks.map(function(t){
    if (t.id !== id) return t;
    const order = ['today','week1','week2','week3','week4','month'];
    const idx = order.indexOf(t.bucket);
    const next = order[Math.min(order.length-1, idx+1)];
    return Object.assign({}, t, { bucket: next, updatedAt: Date.now() });
  });
  save(); renderAll();
}
function deleteTask(id) {
  state.tasks = state.tasks.filter(function(t){ return t.id !== id; });
  save(); renderAll();
}

function openTaskModal(taskId) {
  editingId = taskId || null;
  const isEdit = !!taskId;
  const t = isEdit ? state.tasks.find(function(x){ return x.id===taskId; }) : null;
  document.getElementById('taskModalTitle').textContent = isEdit ? 'Edit Task' : 'Add Task';
  document.getElementById('taskTitle').value = t ? t.title : '';
  document.getElementById('taskGoal').value = t ? t.goalId : 'stat';
  document.getElementById('taskBucket').value = t ? t.bucket : 'today';
  document.getElementById('taskNote').value = t ? t.note : '';
  document.getElementById('taskLink').value = t ? t.link : '';
  document.getElementById('taskModal').style.display='flex';
}
function closeTaskModal(){ document.getElementById('taskModal').style.display='none'; editingId=null; }

function saveTask() {
  const title = document.getElementById('taskTitle').value.trim();
  if (!title) { alert('Title required'); return; }
  const goalId = document.getElementById('taskGoal').value;
  const bucket = document.getElementById('taskBucket').value;
  const note = document.getElementById('taskNote').value.trim();
  const link = document.getElementById('taskLink').value.trim();
  const now = Date.now();
  if (editingId) {
    state.tasks = state.tasks.map(function(t){
      return t.id===editingId ? Object.assign({}, t, { title, goalId, bucket, note, link, updatedAt: now }) : t;
    });
  } else {
    state.tasks.push({ id:id(), title, goalId, bucket, note, link, status:'todo', createdAt: now, updatedAt: now });
  }
  save(); closeTaskModal(); renderAll();
}

function editTask(id){ openTaskModal(id); }

function renderAll() {
  renderTiles();
  renderChecklist();
  if (document.getElementById('backdrop').style.display === 'flex') {
    renderModalTasks();
    renderModalKpis(categories[state.currentCategory]);
  }
  helperSuggest(categories[state.currentCategory]);
}

document.getElementById('drawerToggle').onclick = toggleDrawer;
document.getElementById('btnCloseModal').onclick = closeCategory;
document.getElementById('backdrop').onclick = function(e){ if(e.target.id==='backdrop') closeCategory(); };
document.getElementById('btnAddTask').onclick = function(){ openTaskModal(); };
document.getElementById('btnCloseTaskModal').onclick = closeTaskModal;
document.getElementById('taskModal').onclick = function(e){ if(e.target.id==='taskModal') closeTaskModal(); };
document.getElementById('btnSaveTask').onclick = saveTask;
document.getElementById('btnSnoozeWeek').onclick = function(){
  const bucketSel = document.getElementById('taskBucket');
  const order = ['today','week1','week2','week3','week4','month'];
  const next = order[Math.min(order.length-1, order.indexOf(bucketSel.value)+1)];
  bucketSel.value = next;
};
document.getElementById('filterGoal').onchange = renderAll;
document.getElementById('filterBucket').onchange = renderAll;

(function init(){
  load();
  renderAll();
  if (!state.tasks.length) {
    state.tasks = [
      {id:id(), title:'Do 2 stat sessions', goalId:'stat', status:'todo', bucket:'week1', note:'Use best gym bonus', link:'', createdAt:Date.now(), updatedAt:Date.now()},
      {id:id(), title:'Check FF band targets', goalId:'war', status:'todo', bucket:'week1', note:'Aim 3.5–4.4x', link:'', createdAt:Date.now(), updatedAt:Date.now()},
      {id:id(), title:'Set income routine', goalId:'income', status:'todo', bucket:'week2', note:'Pick passive cycle', link:'', createdAt:Date.now(), updatedAt:Date.now()}
    ];
    save();
    renderAll();
  }
})();
</script>
</body>
</html>
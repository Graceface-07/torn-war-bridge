const TORN_API_KEY = 'CZP2D2ZnbXWsYiDT';
const SC_KEY = 'rwLgZTyqgWDxhoCx';

function doGet() {
  return HtmlService.createHtmlOutput(getHTML())
    .setTitle('TACTICAL HUD V1.8.3')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)
}

function getScouterDataBatch(targetsCsv, uid) {
  try {
    const url = "https://ffscouter.com/api/v1/get-stats?key=" + SC_KEY + "&targets=" + targetsCsv + "&user_id=" + uid;
    return JSON.parse(UrlFetchApp.fetch(url, { muteHttpExceptions: true }).getContentText());
  } catch (e) { return []; }
}

function getFactionData(fid) {
  try {
    const res = UrlFetchApp.fetch("https://api.torn.com/faction/"+fid+"?selections=basic&key="+TORN_API_KEY, { muteHttpExceptions: true });
    return JSON.parse(res.getContentText());
  } catch (e) { return { error: "FACTION_API_FAIL" }; }
}

function getUserName(uid) {
  try {
    const res = JSON.parse(UrlFetchApp.fetch("https://api.torn.com/user/"+uid+"?selections=profile,battlestats&key="+SC_KEY, { muteHttpExceptions: true }).getContentText());
    if (res.error) return { name: "API ERROR", total: 0, errCode: res.error.code };
    return {
      name: (res.name || "OPERATOR").toUpperCase(),
      total: Number(res.total) || 0
    };
  } catch (e) { return { name: "FETCH FAIL", total: 0, errCode: "SYSTEM" }; }
}

function getHTML() {
  return `<!DOCTYPE html>
<html>
<head>
<style>
body { background:#111; color:#fff; font-family:'Inter',sans-serif; margin:0; }
#main-ui { display:block; }
#modalReportBg { display:none; position:fixed; left:0;top:0;width:100vw;height:100vh;background:#000;opacity:0.7;z-index:1100; }
#modalReport { display:none; position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); z-index:1200; min-width:420px; }
.nav-pill { background:#333; border:1px solid #444; padding:8px 18px; border-radius:25px; color:#fff; cursor:pointer; font-size:16px; font-weight:600; text-decoration:none; border:none; }
</style>
</head>
<body>
<div id="main-ui">
  <div style="font-size:24px;margin-bottom:16px;">TACTICAL INTERFACE DEMO</div>
  <button class="nav-pill" id="reportBtn">GENERATE REPORT</button>
</div>
<div id="modalReportBg"></div>
<div id="modalReport">
  <button id="closeReportBtn" style="position:absolute;top:24px;right:38px;background:#181c22;border:none;color:#f6da00;font-size:30px;font-weight:900; cursor:pointer;">✕</button>
  <div id="reportPanelContent"></div>
</div>
<script>
window.SESSION = {
  rawData: [
    {tier:'easy', ff:3.5},
    {tier:'easy', ff:3.4},
    {tier:'easy', ff:3.1},
    {tier:'prime', ff:2.3},
    {tier:'risky', ff:1.7},
    {tier:'suicide', ff:1.1}
  ]
};

document.addEventListener('DOMContentLoaded', function() {
  document.getElementById('main-ui').style.display = 'block';
  document.getElementById('modalReportBg').style.display = 'none';
  document.getElementById('modalReport').style.display = 'none';
  document.getElementById('reportBtn').onclick = generateReport;
  document.getElementById('closeReportBtn').onclick = function(){
    document.getElementById('modalReportBg').style.display = 'none';
    document.getElementById('modalReport').style.display = 'none';
  }
});

function generateReport() {
  const TIER_MAP = {
    'easy': 'SAFE', 'prime': 'PRIME', 'risky': 'RISKY', 'suicide': 'SUICIDE',
    'green': 'SAFE', 'amber': 'PRIME', 'blue': 'RISKY', 'red': 'SUICIDE'
  };
  const TIER_COLOR = {
    'SAFE': '#00ff88',
    'PRIME': '#f6da00',
    'RISKY': '#00d4ff',
    'SUICIDE': '#ff3333'
  };
  var data = window.SESSION.rawData;
  if (!data.length) {
    alert('No scan data. Run a scan first.');
    return;
  }
  let tierGroups = { SAFE: [], PRIME: [], RISKY: [], SUICIDE: [] };
  data.forEach(function(t){
    var mapped = TIER_MAP[t.tier] || 'RISKY';
    tierGroups[mapped].push(t);
  });

  var sims = [];
  var left = 20;
  ['SAFE','PRIME','RISKY'].forEach(function(tier){
    tierGroups[tier].sort(function(a,b){return b.ff-a.ff;});
    tierGroups[tier].forEach(function(t){
      if(left>0){ sims.push(t); left--; }
    });
  });

  var totalRespect = sims.reduce(function(sum, t){return sum+(t.ff*2.71*1.4);},0);
  var avgRespect = sims.length ? (totalRespect/sims.length) : 0;
  var simHits = sims.length;
  var gap = totalRespect >= 8 ? 0 : (20 - simHits);

  var verdict = 'COMMAND VERDICT';
  var status = '';
  var verdictMsg = '';
  var verdictColor = '';
  if (totalRespect < 8) {
    verdictMsg = "POOR RANK WAR";
    verdictColor = "#ff3333";
    status = "8.0 GOAL MATHEMATICALLY IMPOSSIBLE AGAINST THIS POOL";
  } else if (avgRespect < 1.5) {
    verdictMsg = "MODERATE RANK WAR";
    verdictColor = "#f6da00";
    status = "VICTORY POSSIBLE BUT LOW EFFICIENCY";
  } else {
    verdictMsg = "EXCELLENT RANK WAR";
    verdictColor = "#00ff88";
    status = "EXPECTED TO EXCEED RESPECT GOAL";
  }

  function tierCol(NAME, color, metrics) {
    var lines = '';
    metrics.forEach(function(m){
      lines += '<div style="font-size:16px; margin:7px 0;">' + m + '</div>';
    });
    return '<div style="flex:1; margin:0 15px;">'
      + '<div style="color:' + color + '; font-family:Orbitron; font-size:24px; font-weight:700; letter-spacing:2px;">' + NAME + '</div>'
      + '<div style="margin-top:9px; margin-bottom:10px;">' + lines + '</div>'
    + '</div>';
  }

  function sumRespect(arr) { return arr.reduce(function(a, b){ return a + (b.ff*2.71*1.4); }, 0); }
  function avgRespectArr(arr) { return arr.length ? sumRespect(arr)/arr.length : 0; }

  var safe = tierGroups.SAFE;
  var prime = tierGroups.PRIME;
  var risky = tierGroups.RISKY;
  var suicide = tierGroups.SUICIDE;
  var safeHits = sims.filter(function(t){return TIER_MAP[t.tier]==="SAFE";}).length;
  var primeHits = sims.filter(function(t){return TIER_MAP[t.tier]==="PRIME";}).length;
  var riskyHits = sims.filter(function(t){return TIER_MAP[t.tier]==="RISKY";}).length;

  var outHtml = ''
  + '<div style="padding:50px 28px 36px 28px; background:#181c22; border-radius:19px; box-sizing:border-box; min-width:420px; max-width:98vw; max-height:97vh; box-shadow: 0 0 64px #000c; position:relative;">'
    + '<div style="text-align:center; letter-spacing:3px;">'
      + '<div style="font-family:Orbitron; font-size:27px; color:#f6da00; font-weight:800; margin-bottom:7px;">' + verdict + '</div>'
      + '<div style="font-family:Orbitron; font-size:37px; color:' + verdictColor + '; font-weight:900; margin-bottom:10px;">' + verdictMsg + '</div>'
      + '<div style="font-size:16px; color:#fff; font-family:monospace; letter-spacing:2px; margin-bottom:26px; text-transform:uppercase;">' + status + '</div>'
    + '</div>'
    + '<div style="margin:0 auto; margin-bottom:36px; text-align:center;">'
      + '<div style="font-size:20px; font-family:Orbitron; letter-spacing:2px; color:#fff; margin-bottom:11px;">'
        + '20‑HIT EST.: <span style="font-weight:700;">' + totalRespect.toFixed(2) + ' RESPECT</span></div>'
      + '<div style="font-size:20px; font-family:Orbitron; letter-spacing:2px; color:#fff; margin-bottom:11px;">'
        + 'GAP ANALYSIS: <span style="font-weight:700;">' + gap + ' WASTED HITS</span></div>'
      + '<div style="font-size:20px; font-family:Orbitron; letter-spacing:2px; color:#fff;">'
        + 'EFFICIENCY: <span style="font-weight:700;">' + avgRespect.toFixed(2) + ' AVG / HIT</span></div>'
    + '</div>'
    + '<div style="display:flex; justify-content:center; gap:22px;">'
      + tierCol('SAFE', TIER_COLOR['SAFE'], [
        'TARGETS: ' + safe.length,
        'SIM HITS: ' + safeHits,
        'EST. RESP: ' + sumRespect(safeHits ? safe.slice(0, safeHits) : []).toFixed(2),
        'AVG/HIT: ' + avgRespectArr(safeHits ? safe.slice(0, safeHits) : []).toFixed(2)
      ])
      + tierCol('PRIME', TIER_COLOR['PRIME'], [
        'TARGETS: ' + prime.length,
        'SIM HITS: ' + primeHits,
        'EST. RESP: ' + sumRespect(primeHits ? prime.slice(0, primeHits) : []).toFixed(2),
        'AVG/HIT: ' + avgRespectArr(primeHits ? prime.slice(0, primeHits) : []).toFixed(2)
      ])
      + tierCol('RISKY', TIER_COLOR['RISKY'], [
        'TARGETS: ' + risky.length,
        'SIM HITS: ' + riskyHits,
        'EST. RESP: ' + sumRespect(riskyHits ? risky.slice(0, riskyHits) : []).toFixed(2),
        'AVG/HIT: ' + avgRespectArr(riskyHits ? risky.slice(0, riskyHits) : []).toFixed(2)
      ])
      + tierCol('SUICIDE', TIER_COLOR['SUICIDE'], [
        'TARGETS: ' + suicide.length,
        'STATUS: NOT VIABLE'
      ])
    + '</div>'
  + '</div>';

  document.getElementById('reportPanelContent').innerHTML = outHtml;
  document.getElementById('modalReportBg').style.display = 'block';
  document.getElementById('modalReport').style.display = 'block';
}
</script>
</body>
</html>`;
}
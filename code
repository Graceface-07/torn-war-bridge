// Main data loader (fetch summary for top bar, load faction, show dashboard)
function fetchAllData() {
  google.script.run.withSuccessHandler(function(resUser){
    if(!resUser || !resUser.success) {
      showSetupError('Error loading user data: ' + (resUser?.error || 'Unknown'));
      return;
    }
    loadedUser = resUser.data;
    google.script.run.withSuccessHandler(function(resFac){
      if(!resFac || !resFac.success) {
        showSetupError('Error loading faction data: ' + (resFac?.error || 'Unknown'));
        return;

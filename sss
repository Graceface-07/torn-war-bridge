<!DOCTYPE html>
<html>
<head>
    <base target="_top">
    <style>
        :root { 
          --red: #ff4444; --green: #00ff00; --gold: #ffbe0b; --bg: #000; 
          --blue: #3a86ff; --cyan: #00ffff; --gray: #1a1a1a; --text-dim: #777;
        }
        body { background: var(--bg); color: #fff; font-family: 'Courier New', monospace; padding: 10px; margin: 0; }
        
        /* Tactical Loading Pulse */
        .pulse { height: 2px; width: 100%; background: #111; position: relative; overflow: hidden; margin-bottom: 10px; }
        .pulse::after { content: ""; position: absolute; left: -150%; width: 150%; height: 100%; background: linear-gradient(90deg, transparent, var(--cyan), transparent); animation: loading 1.5s infinite; }
        @keyframes loading { 0% { left: -150%; } 100% { left: 100%; } }

        /* Control Module */
        .module { padding: 8px; background: #0a0a0a; display: flex; gap: 5px; align-items: center; border: 1px solid #333; margin-bottom: 10px; border-radius: 4px; }
        input { background: #000; color: var(--gold); border: 1px solid #444; padding: 6px; width: 65px; text-align: center; font-family: monospace; }
        button { background: var(--gold); color: #000; border: none; padding: 7px 10px; font-weight: bold; cursor: pointer; font-size: 10px; text-transform: uppercase; }
        button:hover { background: #fff; }

        /* Grid Layout */
        .comparison-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .column-header { background: #111; padding: 8px; border-bottom: 2px solid var(--gold); text-align: center; font-weight: bold; font-size: 11px; color: var(--gold); }
        
        /* Member Rows */
        .match-row { padding: 8px 0; border-bottom: 1px solid #111; position: relative; }
        .player-link { color: var(--cyan); text-decoration: none; font-weight: bold; font-size: 12px; display: block; max-width: 65%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        
        /* Status Tags */
        .status-tag { font-size: 9px; padding: 2px 4px; border-radius: 2px; color: #000; font-weight: 800; text-align: center; position: absolute; right: 0; top: 8px; min-width: 45px; }
        .status-tag.travel { background: var(--blue); color: #fff; }
        .status-tag.okay { background: var(--green); }
        .status-tag.hosp { background: var(--red); }
        .stat-line { color: var(--gold); font-weight: bold; font-size: 10px; margin-top: 2px; }
        .advice { font-size: 9px; color: var(--text-dim); margin-top: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; width: 100%; }
        .rec { color: var(--cyan); font-weight: bold; font-size: 9px; border: 1px solid var(--cyan); padding: 0 3px; border-radius: 2px; margin-left: 5px; }
    </style>
</head>
<body>
    <div id="loader" class="pulse" style="visibility: hidden;"></div>

    <div class="module">
        <input type="number" id="id1" placeholder="FAC A">
        <input type="number" id="id2" placeholder="FAC B">
        <input type="number" id="spyId" placeholder="SPY ID" style="border-color: var(--blue); width: 60px;">
        <button id="compareBtn">ENGAGE</button>
        <button id="knownBtn" style="background:#222; color:#fff;">KNOWN</button>
    </div>

    <div class="comparison-grid">
        <div id="col1"><div class="column-header">READY...</div><div class="list"></div></div>
        <div id="col2"><div class="column-header">READY...</div><div class="list"></div></div>
    </div>

<script>
    let statusCache = {};

    // 1. Initial Load: Get the Faction Book
    google.script.run.withSuccessHandler(book => {
        const select = document.getElementById('book');
        for (let name in book) {
            let opt = document.createElement('option');
            opt.value = book[name]; opt.innerText = name;
            select.appendChild(opt);
        }
    }).getFactionBook();

    // 2. Main Trigger: Handles the column visibility
    function triggerUpdate() {
        const id1 = document.getElementById('id1').value;
        const id2 = document.getElementById('id2').value;
        
        if (id1) updateColumn(id1, 'col1');
        
        if (id2) {
            document.getElementById('col2').style.display = "block";
            updateColumn(id2, 'col2');
        } else {
            document.getElementById('col2').style.display = "none";
        }
    }

    // 3. The Specific Function you were looking for
    // Connects the UI to the Key Rotation Engine in Code.gs
    function updateColumn(id, colId) {
        google.script.run.withSuccessHandler(res => {
            if (res.error) {
                document.getElementById(colId).querySelector('.list').innerHTML = 
                    `<p style="color:red; font-size:10px; padding:10px;">${res.msg}</p>`;
                return;
            }
            
            // Updates Header with Faction Name and the Active Key being used
            const header = document.getElementById(colId).querySelector('.column-header');
            header.innerHTML = `${res.data.name.toUpperCase()} <br><span style="font-size:8px; color:#555; font-weight:normal;">KEY: ${res.keyDesc}</span>`;
            
            render(res.data, colId);
        }).fetchWithRotation(id);
    }

    // 4. Data Rendering logic
    function render(data, colId) {
        const listDiv = document.getElementById(colId).querySelector('.list');
        let html = "";
        
        // Convert members object to array and sort by level
        const members = Object.keys(data.members).map(k => ({ uid: k, ...data.members[k] }))
            .sort((a,b) => b.level - a.level);

        members.forEach(m => {
            const state = m.status.state;
            const isTravel = m.status.purpose === 'Traveling' || state === 'Abroad';
            const cls = isTravel ? "travel" : (state === 'Okay' ? "okay" : "hosp");
            
            // Automated Discord Spy Logic
            if (statusCache[m.uid] && statusCache[m.uid] !== state) {
                google.script.run.sendDiscordAlert(`**${m.name}** [${data.name}] is now **${state.toUpperCase()}**`);
            }
            statusCache[m.uid] = state;

            html += `<div class="match-row">
                <span class="status-tag ${cls}">${state.toUpperCase()}</span>
                <a href="https://www.torn.com/profiles.php?XID=${m.uid}" target="_blank" class="player-link">${m.name}</a>
                <div class="sub-data">LVL ${m.level} | ${m.status.description}</div>
            </div>`;
        });
        listDiv.innerHTML = html;
    }

    // Set Engage button to trigger the update
    document.querySelector(<button onclick="triggerUpdate()">ENGAGE</button>onclick = triggerUpdate;

    // Automated refresh every 60 seconds
   // This manually ensures the button works even if the HTML attribute is missing
    const btn = document.querySelector('button');
    if(btn) btn.onclick = triggerUpdate;

    // Automated refresh every 60 seconds
    setInterval(triggerUpdate, 60000);
</script>
</body>
</html>
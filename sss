function doGet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss.getSheetByName("HUD_DB")) {
    ss.insertSheet("HUD_DB").getRange("A1:C1").setValues([["User ID", "Name", "Stats"]]);
  }
  return HtmlService.createTemplateFromFile('Index').evaluate()
    .setTitle('WAR HUD - BYPASS')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

// HUD calls this once on startup. Zero URLFetch hits.
function getLocalStats() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("HUD_DB");
  const data = sheet.getDataRange().getValues();
  let db = {};
  data.slice(1).forEach(row => { if(row[0]) db[row[0]] = row[2]; });
  return db;
}

